{
  "name": "northlight-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Accessible, themeable React component library with a design-token system.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter northlight-ui-docs dev",
    "a11y": "pnpm --filter northlight-ui-docs build && pnpm --filter northlight-ui-docs test:a11y",
    "size": "turbo run size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "latest",
    "typescript": "latest"
  }
}
